region    = "eu-west-2"
image_tag = "0.1.1"

domain = "satchel.example.com"
# With a Route 53 public zone the ACM certificate validates itself.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Your SSO (any OIDC IdP: Okta, Entra ID, Google, Cognito, ...).
oidc_issuer    = "https://acme.okta.com"
oidc_client_id = "0oa1b2c3d4e5f6g7h8i9"
# Leave unset and store it after apply with the oidc_secret_command output, or pass it with
# TF_VAR_oidc_client_secret. Never write it here.

replicas = 2

# Use an existing VPC instead of creating one (private subnets in 2+ AZs; public subnets tagged
# kubernetes.io/role/elb = 1 for the ALB).
# vpc_id                      = "vpc-0123456789abcdef0"
# private_subnet_ids          = ["subnet-aaa", "subnet-bbb", "subnet-ccc"]
# public_subnet_ids           = ["subnet-ddd", "subnet-eee", "subnet-fff"]
# vpc_cidr_for_network_policy = "10.0.0.0/16"

# compute = "fargate"   # no nodes to manage; secrets become Kubernetes Secrets (docs/deploy/eks.md)

# Lock the Kubernetes API down to your office or VPN, and add your platform team's role.
# cluster_public_access_cidrs  = ["203.0.113.0/24"]
# cluster_admin_principal_arns = ["arn:aws:iam::123456789012:role/PlatformAdmin"]

# database_multi_az = true

# Create the first workspace automatically after install (OIDC login as this email becomes admin).
# first_workspace = { slug = "acme", name = "Acme", admin_email = "you@example.com" }
