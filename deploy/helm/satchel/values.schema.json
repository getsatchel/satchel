{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "env": {
      "enum": [
        "production",
        "development"
      ]
    },
    "logFormat": {
      "enum": [
        "json",
        "text"
      ]
    },
    "resultDir": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(gs://|s3://|/)"
    },
    "sessionRetentionDays": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 7,
      "maximum": 3650
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "extra": {
          "type": "object"
        }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "extraEnv": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "existingSecret": {
      "type": "string"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "databaseUrl": {
          "type": "string"
        },
        "adminDatabaseUrl": {
          "type": "string"
        },
        "migrationDatabaseUrl": {
          "type": "string"
        },
        "oidcClientSecret": {
          "type": "string"
        },
        "chatApiKey": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "encryptionKey": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{64})?$",
          "description": "SATCHEL_ENCRYPTION_KEY (dev only; use existingSecret or secretManager in production)."
        }
      }
    },
    "secretManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "bootstrapSecrets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provider": {
          "type": "string",
          "enum": [
            "gke",
            "aws"
          ]
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "usePodIdentity": {
              "type": "boolean"
            }
          }
        },
        "migrationSecrets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": {
              "$ref": "#/$defs/probe"
            },
            "readiness": {
              "$ref": "#/$defs/probe"
            },
            "liveness": {
              "$ref": "#/$defs/probe"
            }
          }
        },
        "topologySpreadConstraints": {
          "type": "boolean"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "deployment",
            "cronjob",
            "disabled"
          ]
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "schedule": {
          "type": "string"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "firstWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "slug": {
          "type": "string",
          "pattern": "^([a-z0-9][a-z0-9-]*)?$"
        },
        "name": {
          "type": "string"
        },
        "adminEmail": {
          "type": "string"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "gcpServiceAccount": {
          "type": "string"
        },
        "awsRoleArn": {
          "type": "string",
          "pattern": "^(|arn:aws[a-z-]*:iam::[^:]+:role/.+)$"
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "awsRoleArn": {
              "type": "string",
              "pattern": "^(|arn:aws[a-z-]*:iam::[^:]+:role/.+)$"
            },
            "gcpServiceAccount": {
              "type": "string"
            }
          }
        }
      }
    },
    "cloudSqlProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "instanceConnectionName": {
          "type": "string"
        },
        "privateIp": {
          "type": "boolean"
        },
        "autoIamAuthn": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "gke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "gateway",
            "ingress",
            "none"
          ]
        },
        "host": {
          "type": "string"
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 300
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentRefs": {
          "type": "array"
        },
        "create": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "certificateMap": {
          "type": "string"
        },
        "tlsSecretName": {
          "type": "string"
        },
        "healthCheckPath": {
          "type": "string"
        },
        "staticIpName": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tlsSecretName": {
          "type": "string"
        },
        "managedCertificate": {
          "type": "boolean"
        },
        "staticIpName": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array"
        },
        "allowGkeLoadBalancers": {
          "type": "boolean"
        },
        "extraEgress": {
          "type": "array"
        },
        "allowCidrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "devPostgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "appPassword": {
          "type": "string"
        },
        "workerPassword": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        }
      }
    },
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "alb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "type": "string",
              "enum": [
                "internet-facing",
                "internal"
              ]
            },
            "certificateArn": {
              "type": "string"
            },
            "sslPolicy": {
              "type": "string"
            },
            "groupName": {
              "type": "string"
            },
            "wafv2AclArn": {
              "type": "string"
            },
            "securityGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "region": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "env": {
            "const": "production"
          }
        }
      },
      "then": {
        "properties": {
          "extraEnv": {
            "not": {
              "required": [
                "SATCHEL_DEV_AUTH"
              ]
            }
          },
          "devPostgres": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
