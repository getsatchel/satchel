# Copy to .env and fill in every value. Never commit .env.
# Generate each password and the key with:  openssl rand -hex 32
# (hex keeps them safe inside the database URLs).

SATCHEL_IMAGE_TAG=0.5.1
SATCHEL_DOMAIN=satchel.example.com

POSTGRES_PASSWORD=
SATCHEL_APP_DB_PASSWORD=
SATCHEL_WORKER_DB_PASSWORD=
# Encrypts secrets saved in Settings. Back it up outside this machine: lose it and they must be re-entered.
SATCHEL_ENCRYPTION_KEY=

# Your OIDC provider. For Amazon Cognito the issuer is
# https://cognito-idp.<region>.amazonaws.com/<user-pool-id>; the callback URL is https://<domain>/auth/callback.
SATCHEL_OIDC_ISSUER=
SATCHEL_OIDC_CLIENT_ID=
SATCHEL_OIDC_CLIENT_SECRET=
# Cognito only: inviting a member also creates their Cognito user (the instance role needs
# cognito-idp:AdminCreateUser on the pool). See docs/deploy/vm.md.
# SATCHEL_OIDC_CREATE_USERS=true

# Embeddings. fastembed runs a local model that needs about 1.3 GiB in both web and worker: use a
# 4 GiB machine (t3.medium). On 2 GiB (t3.small), use openai_compat with an API key, or hash
# (no model, weak search). After changing it, run: docker compose run --rm web sync reembed -w <workspace>
SATCHEL_EMBEDDING_PROVIDER=fastembed
# SATCHEL_EMBEDDING_BASE_URL=https://api.openai.com/v1
# SATCHEL_EMBEDDING_MODEL=text-embedding-3-large
SATCHEL_EMBEDDING_API_KEY=

# The first workspace. Signing in with this email makes you its admin.
SATCHEL_WORKSPACE=main
SATCHEL_WORKSPACE_NAME=Main
SATCHEL_ADMIN_EMAIL=you@example.com
