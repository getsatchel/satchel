POSTGRES_USER=satchel
POSTGRES_PASSWORD=satchel
POSTGRES_DB=satchel
# Runtime: a plain role, so row-level security applies (created by deploy/compose/initdb).
SATCHEL_DATABASE_URL=postgresql+psycopg://satchel_app:satchel_app@localhost:5433/satchel
# Server-internal jobs: the satchel_worker role (RLS policies admit it by role; also from initdb).
SATCHEL_ADMIN_DATABASE_URL=postgresql+psycopg://satchel_worker:satchel_worker@localhost:5433/satchel
# Migrations only (`satchel db upgrade`): the table owner.
SATCHEL_MIGRATION_DATABASE_URL=postgresql+psycopg://satchel:satchel@localhost:5433/satchel
