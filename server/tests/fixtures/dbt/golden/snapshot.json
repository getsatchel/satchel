  "queries": [
    {
      "description": "Revenue and order count by month.",
      "key": "saved_query.monthly_revenue",
      "metric_query": {
        "dimensions": [
          "metric_time:month"
        ],
        "metrics": [
          "revenue",
          "order_count"
        ]
      },
      "question": "Revenue and order count by month.",
      "sql": null,
      "variants": [
        "monthly revenue"
      ]
    }
  ],
  "semantic_models": [
    {
      "description": "Metrics defined in the dbt project jaffle_shop",
      "key": "semantic.jaffle_shop",
      "mdl": {
        "catalog": "jaffle_shop",
        "cubes": [
          {
            "baseObject": "orders",
            "description": "Customer orders, one row per order.",
            "dimensions": [
              {
                "description": "Order status (placed, shipped or completed for valid orders).",
                "expression": "status",
                "name": "status",
                "type": "VARCHAR"
              },
              {
                "description": "foreign entity",
                "expression": "customer_id",
                "name": "customer",
                "type": "VARCHAR"
              },
              {
                "description": "primary entity",
                "expression": "order_id",
                "name": "order_id",
                "type": "VARCHAR"
              }
            ],
            "measures": [
              {
                "description": "Revenue divided by valid order count, in AUD dollars.",
                "expression": "CAST(SUM(CASE WHEN (status NOT IN ('returned', 'return_pending') AND customer_id <> 0) THEN amount / 100.0 END) AS DOUBLE) / NULLIF(CAST(COUNT(CASE WHEN (status NOT IN ('returned', 'return_pending') AND customer_id <> 0) THEN order_id END) AS DOUBLE), 0)",
                "name": "average_order_value",
                "type": "DOUBLE"
              },
              {
                "description": "Number of valid orders.",
                "expression": "COUNT(CASE WHEN (status NOT IN ('returned', 'return_pending') AND customer_id <> 0) THEN order_id END)",
                "name": "order_count",
                "type": "BIGINT"
              },
              {
                "description": "Sum of order amounts in AUD dollars for valid orders (excludes returned, return_pending and the internal test customer).",
                "expression": "SUM(CASE WHEN (status NOT IN ('returned', 'return_pending') AND customer_id <> 0) THEN amount / 100.0 END)",
                "name": "revenue",
                "type": "DOUBLE"
              }
            ],
            "name": "orders",
            "timeDimensions": [
              {
                "description": "Date the order was placed (Australia/Sydney).",
                "expression": "order_date",
                "name": "order_date",
                "type": "DATE"
              },
              {
                "description": "Alias of order_date, the default time dimension",
                "expression": "order_date",
                "name": "metric_time",
                "type": "DATE"
              }
            ]
          }
        ],
        "dataSource": "duckdb",
        "models": [
          {
            "columns": [
              {
                "name": "amount",
                "type": "integer"
              },
              {
                "name": "customer_id",
                "type": "integer"
              },
              {
                "name": "order_date",
                "type": "date"
              },
              {
                "name": "order_id",
                "type": "integer"
              },
              {
                "name": "status",
                "type": "varchar"
              }
            ],
            "description": "Customer orders, one row per order.",
            "name": "orders",
            "primaryKey": "order_id",
            "tableReference": {
              "schema": "analytics",
              "table": "orders"
            }
          }
        ],
